# Runtime mode. "test" uses the MockProvider for all AI calls (no network, no cost).
# "production" calls real provider APIs and requires the API keys below.
GEO_ENV=test

# SQLite database file path.
GEO_DB_PATH=./data/geo.sqlite

# HTTP API port.
GEO_PORT=3000

# --- AI provider credentials (required only when GEO_ENV=production) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Per-provider rate limiting / retry configuration (all optional, sane defaults apply) ---
OPENAI_MAX_CONCURRENT=3
OPENAI_REQUESTS_PER_MINUTE=60
OPENAI_RETRY_LIMIT=3
OPENAI_TIMEOUT_MS=30000

GEMINI_MAX_CONCURRENT=3
GEMINI_REQUESTS_PER_MINUTE=60
GEMINI_RETRY_LIMIT=3
GEMINI_TIMEOUT_MS=30000

ANTHROPIC_MAX_CONCURRENT=3
ANTHROPIC_REQUESTS_PER_MINUTE=60
ANTHROPIC_RETRY_LIMIT=3
ANTHROPIC_TIMEOUT_MS=30000

# Default number of questions generated per scan when the caller doesn't specify one.
GEO_DEFAULT_QUESTION_COUNT=25

# Minimum log level printed to stdout: DEBUG | INFO | SUCCESS | WARNING | ERROR
GEO_LOG_LEVEL=INFO
